fatorial = 1
num_original = int(input("\033[32mDigite um número para calcular seu Fatorial: \033[0m"))
n = num_original  # 🌟 Criamos uma cópia de segurança para o 'n' poder gastar no while!

print(f"\033[34mCalculando {num_original}! = \033[0m", end="")

while n > 0:
    # 🎨 Esse print mostra a conta linda na tela (ex: 5 x 4 x 3...)
    print(f"{n}", end="")
    print(" x " if n > 1 else " = ", end="") # Se for maior que 1 poe 'x', se for o último poe '='
    fatorial *= n
    n -= 1

# 🌟 Usamos o 'num_original' aqui no final pro print fazer sentido!
print(f"\033[1;32m{fatorial}\033[0m")
