from datetime import date
data = int(input("Digite o ano que você nasceu: "))
ano_atual = date.today().year
calculo = ano_atual - data
if calculo <=9:
    print(f"Você tem {calculo} anos, está na classe Mirim!")
elif calculo <=14:
    print(f"Você tem {calculo} anos, está na classe Infantil!")
elif calculo <=19:
    print(f"Você tem {calculo} anos, está na classe Junior!")
elif calculo <=25:
    print(f"Você tem {calculo} anos, está na classe Sênior!")
else:
    print(f"Você tem {calculo} anos, está na classe Master!")