import pygame
from time import sleep

#iniciar o mixer no pygame
pygame.mixer.init()

#carregar o arquivo e colocar r no inicio
pygame.mixer.music.load(r"C:\Users\Pichau\Music\piano_mp3.mp3")

# dar o play
pygame.mixer.music.play()

print("\033[32m🎵 Tocando música... Curte o som, mano! \033[0m")

# 🌟 4. A o loop pra segurar o programa enquanto tá rodando
while pygame.mixer.music.get_busy():
    sleep(1) # chega a cada 1 segundo se a musica tá tocando

print("\033[31m⏹️ A música acabou! Fechando o programa.\033[0m")
