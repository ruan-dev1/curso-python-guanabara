c = 1
n = int(input("Digite o primeiro termo: "))    
r = int(input("Digite a razão da PA: "))

while c <= 10:
    # 🌟 A MÁGICA: Se não for o último, põe a seta. Se for o último, encerra limpo!
    if c < 10:
        print(n, end=" --> ")
    else:
        print(n) # Sem o end="", assim ele quebra a linha bonitinho no final!
       
    n += r
    c += 1
