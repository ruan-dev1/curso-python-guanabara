from time import sleep

peso = float(input("\033[34mDigite o peso da pessoa: \033[0m"))
altura = float(input("\033[34mDigite a altura da pessoa: \033[0m"))

imc = peso / (altura ** 2)

# Mensagem de carregamento padrão para não precisar repetir em todo "if"
print("\033[34mCalculando IMC...\033[0m")
sleep(2)

# Condicionais para exibição do resultado
if imc < 18.5:
    print(f"\033[33mA pessoa está abaixo do peso ideal, pois o IMC é de {imc:.1f}\033[0m")
elif 18.5 <= imc < 25:
    print(f"\033[32mA pessoa está com o peso ideal, pois o IMC é de {imc:.1f}\033[0m")
elif 25 <= imc < 30:
    print(f"\033[33mA pessoa está em sobrepeso, pois o IMC é de {imc:.1f}\033[0m")
elif 30 <= imc < 40:
    print(f"\033[31mA pessoa está com obesidade, pois o IMC é de {imc:.1f}\033[0m")
else:
    print(f"\033[31mA pessoa está com obesidade mórbida, CUIDADO! pois o IMC é de {imc:.1f}\033[0m")

