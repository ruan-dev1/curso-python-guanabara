frase = 'Curso Em Vídeo Python '
print(len(frase))  # Imprime o número de caracteres da frase, incluindo os espaços
print(len(frase.strip()))  # Imprime o número de caracteres da frase, sem os espaços no início e no final
print(frase.count('o'))  # Conta quantas vezes a letra 'o' aparece na frase
print(frase.replace('Python', 'Android')) #Sub 
print('Curso' in frase) # Verifica se a palavra 'Curso' está presente na frase, retorna True ou False
print(frase.find('Vídeo')) # Retorna a posição da palavra 'Vídeo' na frase, ou -1 se não for encontrada
print(frase.split())  # Divide a frase em uma lista de palavras
print(frase.upper())  # Transforma a frase toda em maiúscula
print(frase.lower())  # Transforma a frase toda em minúscula
print(frase.capitalize()) # Transforma a primeira letra da frase em maiúscula e o resto em minúscula
print(frase.title()) # Transforma a primeira letra de cada palavra em maiúscula e o resto em minúscula

dividido = frase.split()
print(dividido[0])  # Imprime a primeira palavra da lista
print(dividido[1])  # Imprime a segunda palavra da lista
print(dividido[2], [3]) # 
