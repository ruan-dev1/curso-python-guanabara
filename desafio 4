n = input("Digite algo: ")
print('o tipo primitivo desse valor é {}'.format(type(n)))
print('ele é um numero? {}'.format(n.isnumeric()))
print('ele é do alfabeto? {}'.format(n.isalpha()))
print('ele é alfanumerico? {}'.format(n.isalnum()))
print('ele está em maiusculas? {}'.format(n.isupper()))
print('ele está em minusculas? {}'.format(n.islower()))
print('ele está capitalizado? {}'.format(n.istitle()))
print('ele é imprimivel? {}'.format(n.isprintable()))
print('ele é um espaço? {}'.format(n.isspace()))
print('ele é decimal? {}'.format(n.isdecimal()))
print('ele é um digito? {}'.format(n.isdigit()))
print('ele é um identificador valido? {}'.format(n.isidentifier()))
print('ele é ascii? {}'.format(n.isascii()))
