from random import randint
from time import sleep

computador = randint(1, 10)
tentativas = 0

print("\033[33mVou pensar em um número de 1 a 10... Tente adivinhar!\033[0m")
sleep(1)

while True:
    pessoa = int(input("\nSeu palpite: "))
    tentativas += 1
    
    print("Processando...")
    sleep(1) # 1 segundo para o jogo fluir mais rápido nas tentativas
    
    if pessoa == computador:
        print(f"\033[32mBOA! Você acertou em {tentativas} tentativas!\033[0m")
        break
    else:
        print("\033[31mErrou! Olha a dica:\033[0m", end=" ")
        # A dica já aparece direto para ajudar o jogador a fechar o jogo mais rápido!
        if pessoa < computador:
            print("\033[33mO número secreto é MAIOR.\033[0m")
        else:
            print("\033[33mO número secreto é MENOR.\033[0m")
