from time import sleep

# 🌟 1. Criamos os "atalhos" das cores antes de tudo!
C_PADRAO = "\033[0m"
VERDE = "\033[32m"
AMARELO = "\033[33m"
AZUL = "\033[34m"
VERMELHO = "\033[31m"

# Cores individuais para cada número do menu
C1, C2, C3, C4, C5 = "\033[34m", "\033[35m", "\033[36m", "\033[33m", "\033[31m"

# 🌟 2. Os inputs começam FORA do loop para travar os números!
valor1 = int(input(f"{AMARELO}Digite o primeiro número: {C_PADRAO}"))
valor2 = int(input(f"{AMARELO}Digite o segundo número: {C_PADRAO}"))

while True:
    print(f"\n{AZUL}Escolha uma opção e digite o número desejado:{C_PADRAO}")
    
    # Olha como o menu fica colorido de um jeito muito mais limpo agora:
    print(f"{C1}[1]{C_PADRAO} Somar\n"
          f"{C2}[2]{C_PADRAO} Multiplicar\n"
          f"{C3}[3]{C_PADRAO} Maior\n"
          f"{C4}[4]{C_PADRAO} Novos números\n"
          f"{C5}[5]{C_PADRAO} Sair do programa")
          
    opcao = int(input(f"{AMARELO}Digite a opção desejada: {C_PADRAO}"))
    
    if opcao == 1:
        soma = valor1 + valor2
        print(f"{VERDE}A soma de {valor1} + {valor2} é igual a {soma}{C_PADRAO}")
        sleep(2)
        
    elif opcao == 2:
        multiplicando = valor1 * valor2
        print(f"{VERDE}A multiplicação entre {valor1} * {valor2} é igual a {multiplicando}{C_PADRAO}")
        sleep(2)
        
    elif opcao == 3:
        maior = valor1 if valor1 > valor2 else valor2 # Jeito hacker de achar o maior em uma linha ;)
        print(f"{VERDE}O maior número entre {valor1} e {valor2} é {maior}{C_PADRAO}")
        sleep(2)
        
    elif opcao == 4:
        print(f"{VERDE}Vamos digitar novos números...{C_PADRAO}")
        sleep(1)
        # 🌟 3. Na opção 4, a gente pede os números de novo, atualizando as variáveis!
        valor1 = int(input(f"{AMARELO}Digite o novo primeiro número: {C_PADRAO}"))
        valor2 = int(input(f"{AMARELO}Digite o novo segundo número: {C_PADRAO}"))
        
    elif opcao == 5:
        print(f"{VERDE}Você escolheu sair do programa! Até logo!{C_PADRAO}")
        break
    else:
        print(f"{VERMELHO}Opção inválida! Tente novamente.{C_PADRAO}")
